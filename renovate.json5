{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates",
    "security:gomodIndirectSecurityUpdates",
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packaging/browser\\.yaml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>chromium)\\s+version: (?<upstreamVersion>\\S+)(?<packaging>[\\s\\S]*?debian-revision: )(?<debianRevision>\\S+)",
      ],
      "datasourceTemplate": "deb",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://deb.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64",
      "currentValueTemplate": "{{{upstreamVersion}}}-{{{debianRevision}}}",
      "autoReplaceStringTemplate": "# renovate: depName={{{depName}}}\n  version: {{{replace '-[^-]+$' '' newValue}}}{{{packaging}}}{{{replace '^.*-' '' newValue}}}",
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packaging/build$/"],
      "matchStrings": [
        "(?<depName>cgr\\.dev/chainguard/[^:]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)",
      ],
      "datasourceTemplate": "docker",
    },
  ],
  "packageRules": [
    {
      "matchDatasources": ["deb"],
      "matchPackageNames": ["chromium"],
      "enabled": true,
    },
  ],
}
