{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "security:only-security-updates",
    "security:gomodIndirectSecurityUpdates",
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>chromium)\\s+ARG CHROMIUM_VERSION=(?<currentValue>\\S+)",
      ],
      "datasourceTemplate": "custom.debian-chromium",
      "versioningTemplate": "deb",
      "registryUrlTemplate": "https://packages.debian.org/trixie/amd64/chromium/download",
      "extractVersionTemplate": "chromium_(?<version>[0-9.]+)-[^/]+_amd64\\.deb$",
    },
  ],
  "customDatasources": {
    // Debian Security only provides Packages.xz; the deb datasource requires Packages.gz.
    "debian-chromium": {
      "format": "html",
    },
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["debian"],
      "enabled": true,
      "versioning": "regex:^(?<compatibility>[a-z]+)-(?<patch>\\d{8})(?:\\.(?<build>\\d+))?$",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
    {
      // Use the builder image's published tags to keep the Go versions in sync.
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "overrideDatasource": "docker",
      "overridePackageName": "golang",
      "extractVersion": "^(?<version>\\d+\\.\\d+\\.\\d+)-alpine$",
      "versioning": "semver",
      "pinDigests": false,
      "postUpdateOptions": ["gomodTidy"],
    },
    {
      "matchManagers": ["dockerfile", "gomod"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "enabled": true,
      "allowedVersions": "/^1\\./",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
    {
      "matchManagers": ["dockerfile", "gomod"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go",
      "groupSlug": "go-{{newMajor}}.{{newMinor}}.{{newPatch}}",
      "minimumGroupSize": 2,
    },
    {
      "matchDatasources": ["custom.debian-chromium"],
      "matchPackageNames": ["chromium"],
      "enabled": true,
      "minimumReleaseAgeBehaviour": "timestamp-optional",
    },
  ],
}
